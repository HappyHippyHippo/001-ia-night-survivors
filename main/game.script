local world = require "main.modules.world"

local CHOOSE = hash("choose")

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	world.init()
	-- debug autoplay: dmengine --config=game.autoplay=1 [--config=game.speed=4 --config=game.god=1]
	self.autoplay = sys.get_config_int("game.autoplay", 0) == 1
	self.speed = sys.get_config_int("game.speed", 1)
	world.god = sys.get_config_int("game.god", 0) == 1
	if self.autoplay then
		world.start()
		self.t = 0
	end
end

local function autopilot(self, dt)
	-- wander, but steer away from nearby enemies like a kiting player would
	self.t = self.t + dt
	local p = world.s.player
	local a = self.t * 0.4
	local mx, my = math.cos(a) * 0.3, math.sin(a * 0.7) * 0.3
	for _, e in ipairs(world.s.enemies) do
		local dx, dy = p.x - e.x, p.y - e.y
		local d2 = dx * dx + dy * dy
		if d2 < 160 * 160 and d2 > 1 then
			mx, my = mx + dx / d2 * 60, my + dy / d2 * 60
		end
	end
	local best, bd = nil, 400 * 400
	for _, g in ipairs(world.s.gems) do
		local d2 = (g.x - p.x) ^ 2 + (g.y - p.y) ^ 2
		if d2 < bd then best, bd = g, d2 end
	end
	if best then
		local d = math.sqrt(bd) + 1
		mx, my = mx + (best.x - p.x) / d * 0.9, my + (best.y - p.y) / d * 0.9
	end
	local len = math.sqrt(mx * mx + my * my)
	if len > 0 then mx, my = mx / len, my / len end
	world.input.right, world.input.left = math.max(0, mx), math.max(0, -mx)
	world.input.up, world.input.down = math.max(0, my), math.max(0, -my)
	if world.s.state == "levelup" then
		world.choose(math.random(1, #world.s.choices))
	end
	local s = world.s
	if math.floor(s.time / 15) ~= self.last_report then
		self.last_report = math.floor(s.time / 15)
		local ws = {}
		for _, w in ipairs(s.weapons) do ws[#ws + 1] = w.id .. w.level end
		print(string.format("[autoplay] t=%.0f state=%s lv=%d hp=%.0f kills=%d enemies=%d gems=%d proj=%d weapons=%s",
			s.time, s.state, s.level, s.player.hp, s.kills, #s.enemies, #s.gems, #s.projectiles, table.concat(ws, ",")))
	end
end

function update(self, dt)
	for _ = 1, self.speed do
		if self.autoplay then autopilot(self, dt) end
		world.update(dt)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == CHOOSE then
		world.choose(message.index)
	end
end

function on_input(self, action_id, action)
	world.on_input(action_id, action)
end
