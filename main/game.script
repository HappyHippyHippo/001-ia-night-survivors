local world = require "main.modules.world"

local CHOOSE = hash("choose")
local REROLL = hash("reroll")
local SKIP = hash("skip")

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	world.init()
	-- debug autoplay: dmengine --config=game.autoplay=1 [--config=game.speed=4 --config=game.god=1]
	self.autoplay = sys.get_config_int("game.autoplay", 0) == 1
	self.speed = sys.get_config_int("game.speed", 1)
	world.god = sys.get_config_int("game.god", 0) == 1
	if self.autoplay then
		world.start()
		self.t = 0
		-- --config=game.test_evo=1: start with every weapon maxed plus its partner item, then evolve them all
		if sys.get_config_int("game.test_evo", 0) == 1 then
			local U = require "main.modules.upgrades"
			for _, id in ipairs(U.WEAPON_ORDER) do
				while (U.find_weapon(world.s, id) or { level = 0 }).level < #U.WEAPONS[id].levels do
					U.apply(world.s, { kind = "weapon", id = id, name = id, tag = "" })
				end
				U.apply(world.s, { kind = "passive", id = U.WEAPONS[id].evo.partner, name = id, tag = "" })
			end
			world.s.stats = U.compute_stats(world.s, require("main.modules.config").PLAYER)
			for _ = 1, #U.WEAPON_ORDER do world.open_chest() end
		end
	end
end

local function autopilot(self, dt)
	-- wander, but steer away from nearby enemies like a kiting player would
	self.t = self.t + dt
	local p = world.s.player
	local a = self.t * 0.4
	local mx, my = math.cos(a) * 0.3, math.sin(a * 0.7) * 0.3
	for _, e in ipairs(world.s.enemies) do
		local dx, dy = p.x - e.x, p.y - e.y
		local d2 = dx * dx + dy * dy
		if d2 < 160 * 160 and d2 > 1 then
			mx, my = mx + dx / d2 * 60, my + dy / d2 * 60
		end
	end
	local best, bd = nil, 400 * 400
	for _, g in ipairs(world.s.gems) do
		local d2 = (g.x - p.x) ^ 2 + (g.y - p.y) ^ 2
		if d2 < bd then best, bd = g, d2 end
	end
	if best then
		local d = math.sqrt(bd) + 1
		mx, my = mx + (best.x - p.x) / d * 0.9, my + (best.y - p.y) / d * 0.9
	end
	local len = math.sqrt(mx * mx + my * my)
	if len > 0 then mx, my = mx / len, my / len end
	world.input.right, world.input.left = math.max(0, mx), math.max(0, -mx)
	world.input.up, world.input.down = math.max(0, my), math.max(0, -my)
	if world.s.state == "levelup" then
		if world.s.rerolls > 0 and math.random() < 0.2 then world.reroll() end
		world.choose(math.random(1, #world.s.choices))
	end
	-- exercise the stats screen now and then
	if world.s.state == "playing" and math.floor(world.s.time / 40) ~= self.last_pause then
		self.last_pause = math.floor(world.s.time / 40)
		world.toggle_pause()
		world.toggle_pause()
	end
	local s = world.s
	if math.floor(s.time / 15) ~= self.last_report then
		self.last_report = math.floor(s.time / 15)
		local ws = {}
		for _, w in ipairs(s.weapons) do
			ws[#ws + 1] = w.id .. (w.evolved and "E" or w.level) .. "=" .. math.floor(s.dmg_by[w.id] or 0)
		end
		local ps = {}
		for id, lv in pairs(s.passives) do ps[#ps + 1] = id .. lv end
		print(string.format("[autoplay] t=%.0f state=%s lv=%d hp=%.0f kills=%d enemies=%d gems=%d proj=%d pools=%d eb=%d chests=%d evo=%d weapons=%s passives=%s",
			s.time, s.state, s.level, s.player.hp, s.kills, #s.enemies, #s.gems, #s.projectiles, #s.pools, #s.ebullets,
			s.chests, s.evolutions, table.concat(ws, ","), table.concat(ps, ",")))
	end
end

function update(self, dt)
	for _ = 1, self.speed do
		if self.autoplay then autopilot(self, dt) end
		world.update(dt)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == CHOOSE then
		world.choose(message.index)
	elseif message_id == REROLL then
		world.reroll()
	elseif message_id == SKIP then
		world.skip()
	end
end

function on_input(self, action_id, action)
	world.on_input(action_id, action)
end
